{
    "name": "callismart/dbal",
    "description": "Engine agnostic database abstraction layer. Supports MYSQL, PostgreSQL and SQLite.",
    "type": "library",
    "require": {
        "callismart/dto": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Callismart\\Dbal\\": "src/"
        }
    },
    "autoload-dev": {
        "files" : [
            "tests/Functions.php"
        ]
    },
    "authors": [
        {
            "name": "Callistus Nwachukwu",
            "email": "admin@callismart.com.ng"
        }
    ],
    "minimum-stability": "stable",
    "archive": {
        "exclude": [
            "/tests",
            "/phpunit.xml",
            "/phpunit.xml.dist",
            "/.github"
        ]
    },

    "scripts": {
        "test": "phpunit --colors=always --testdox"
    }
}
