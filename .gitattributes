# Normalize line endings
* text=auto

*.php text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.phar binary

# Dev files (IMPORTANT)
tests/ export-ignore
phpunit.xml export-ignore
.phpunit.result.cache export-ignore
phpunit.xml.dist export-ignore

# CI / tooling
.github export-ignore
/.github export-ignore